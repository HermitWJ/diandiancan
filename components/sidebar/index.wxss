/* compoments/sidebar/index.wxss */
.sidebar{
  width: 100%;
  max-height: 1148rpx;
  background-color: #f8f8f8;
}
.sidebar .sidebar-item{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width:100%;
  height: 138rpx;
  position: relative;
}

.item-icon{
  width: 58rpx;
  height: 58rpx;
}

.item-label{
  font-size: 22rpx;
  font-weight: 400;
}

.left-line{
  width: 6rpx;
  height: 48rpx;
  background-color: brown;
  position: absolute;
  left: 0;
}

.sidebar-item .active .item-icon{
  width: 58rpx;
  height: 58rpx;
}

.active{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width:100%;
  height: 138rpx;
  position: relative;
  background-color: white;
}
 
