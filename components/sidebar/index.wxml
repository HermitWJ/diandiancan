<scroll-view class="sidebar" scroll-y show-scrollbar="{{false}}" enhanced>
  <view wx:for="{{list}}" wx:key="id" class="{{index === current ? 'active' : 'sidebar-item'}}" bind:tap="switch" data-current="{{index}}">
    <image src="../../images/order_yes.png" class="item-icon"></image>
    <view class="item-label">{{item.name}}</view>
    <view wx:if="{{index === current}}" class="left-line"></view>
  </view>
</scroll-view>