/* ===== 购物页面 - 全新精美设计 ===== */

page {
  background: #f5f6fa;
}

.shop-page {
  min-height: 100vh;
}

/* ===== 顶部搜索栏 ===== */
.search-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-right: 0;
}

.bar-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 44rpx;
  line-height: 44rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  font-size: 22rpx;
  color: #fff;
  margin-left: 8rpx;
}

.cancel-btn {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #ff6b35;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 分类横向滚动 ===== */
.category-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f6fa;
  margin-right: 16rpx;
  transition: all 0.2s;
}

.cat-active {
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

/* ===== 加载中 ===== */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #ff6b35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* ===== 结果统计 ===== */
.result-bar {
  padding: 20rpx 28rpx 8rpx;
}

.result-text {
  font-size: 24rpx;
  color: #999;
}

.result-num {
  color: #ff6b35;
  font-weight: 700;
  font-size: 28rpx;
}

/* ===== 菜品列表 ===== */
.goods-list {
  padding: 8rpx 24rpx;
}

.goods-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.goods-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.goods-img-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.goods-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}

.goods-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(255, 107, 53, 0.88);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 200rpx;
  padding: 4rpx 0;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.goods-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.price-sign {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 700;
}

.price-val {
  font-size: 38rpx;
  font-weight: 800;
  color: #ff6b35;
  margin-left: 2rpx;
}

.goods-go-btn {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #bbb;
}
