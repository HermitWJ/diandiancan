/* 西安理工大学食堂详情页样式 */

/* ========== 页面基础 ========== */
.detail-page {
  background: #f5f6fa;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ========== 顶部大图区域 ========== */
.hero-section {
  position: relative;
  width: 100%;
  height: 720rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.55) 100%);
}

.back-btn {
  position: absolute;
  top: 80rpx;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.25);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.share-btn {
  position: absolute;
  top: 80rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.25);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  padding: 0;
  margin: 0;
  line-height: normal;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 34rpx;
  color: #fff;
}

.hero-content {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 5;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
  margin-bottom: 10rpx;
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 2rpx;
}

/* ========== 统计数据区域 ========== */
.stats-section {
  padding: 0 24rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 10;
}

.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff6b35;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: #f0f0f0;
}

/* ========== 通用 Section Header ========== */
.section-header {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* ========== 亮点标签区域 ========== */
.highlights-section {
  padding-top: 40rpx;
}

.highlights-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
}

.highlight-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  border-radius: 20rpx;
}

.highlight-emoji {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.highlight-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.highlight-desc {
  font-size: 22rpx;
  color: #888;
}

/* ========== 餐厅导览区域 ========== */
.canteen-section {
  padding-top: 40rpx;
}

.canteen-card {
  margin: 0 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

.canteen-card-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 16rpx;
}

.canteen-number-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
}

.canteen-info {
  flex: 1;
  margin-left: 20rpx;
}

.canteen-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 8rpx;
}

.canteen-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.canteen-tag {
  padding: 4rpx 16rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #888;
}

.canteen-rating {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rating-star {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.rating-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b35;
}

.canteen-card-body {
  padding: 0 28rpx 28rpx;
}

.canteen-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  display: block;
  margin-bottom: 20rpx;
}

.canteen-features {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.feature-tag {
  padding: 8rpx 18rpx;
  background: #f8f9ff;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #666;
  border: 1rpx solid #eef0ff;
}

.hot-dishes {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fff8f0, #fff3e6);
  border-radius: 14rpx;
}

.hot-dishes-label {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.hot-dishes-text {
  font-size: 24rpx;
  color: #888;
  margin-left: 8rpx;
  line-height: 1.6;
}

/* ========== 温馨小贴士区域 ========== */
.tips-section {
  padding-top: 40rpx;
}

.tips-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
}

.tip-item:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.tip-num {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.tip-content {
  flex: 1;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.tip-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* ========== 底部区域 ========== */
.footer-section {
  padding: 60rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-divider {
  display: flex;
  align-items: center;
  width: 60%;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, #ddd, transparent);
}

.divider-text {
  margin: 0 20rpx;
  font-size: 28rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 8rpx;
}

.footer-slogan {
  font-size: 22rpx;
  color: #ccc;
  letter-spacing: 2rpx;
}
