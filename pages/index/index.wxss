/* ========== 全局页面背景 ========== */
page {
    background: #f3f5f9;
}

page::after {
    content: '';
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 400rpx;
    background: linear-gradient(180deg, #4f84ff 0%, rgba(79, 132, 255, 0.06) 100%);
    pointer-events: none;
    z-index: 0;
}

/* ========== 顶部问候区域 ========== */
.greeting-section {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 39rpx 32rpx 8rpx;
}

.greeting-left {
    display: flex;
    flex-direction: column;
}

.greeting-text {
    font-size: 40rpx;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.greeting-sub {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6rpx;
}

.greeting-right {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    overflow: hidden;
    border: 4rpx solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.avatar-img {
    width: 100%;
    height: 100%;
}

/* ========== 搜索框 ========== */
.search-item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: row;
    background: rgba(255, 255, 255, 0.95);
    margin: 30rpx 24rpx 20rpx;
    border-radius: 40rpx;
    padding: 6rpx 20rpx;
    align-items: center;
    box-shadow: 0 12rpx 36rpx rgba(79, 132, 255, 0.12);
    backdrop-filter: blur(10rpx);
}

.search-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12rpx;
}

.search-img {
    width: 44rpx;
    height: 44rpx;
    opacity: 0.5;
}

.search-box {
    padding: 18rpx 8rpx;
    flex: 1;
    font-size: 28rpx;
    color: #999;
}

/* ========== 滚动公告栏 ========== */
.notice-bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    margin: 12rpx 24rpx;
    padding: 12rpx 24rpx;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.notice-icon {
    font-size: 30rpx;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.notice-swiper {
    height: 48rpx;
    flex: 1;
}

.notice-text {
    font-size: 24rpx;
    color: #666;
    line-height: 40rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ========== 轮播图 ========== */
.banner-section {
    position: relative;
    z-index: 1;
    padding: 16rpx 0;
}

.swiper-item {
    height: 340rpx;
}

.swiper-img-wrap {
    padding: 0 12rpx;
    height: 100%;
}

.swiper-img {
    width: 100%;
    height: 100%;
    border-radius: 24rpx;
    box-shadow: 0 16rpx 40rpx rgba(14, 26, 60, 0.12);
}

/* ========== 快捷功能入口 ========== */
.quick-entry-section {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-around;
    padding: 20rpx 24rpx 12rpx;
    margin: 8rpx 24rpx 0;
    background: #ffffff;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}

.quick-entry-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16rpx 0;
}

.quick-icon-bg {
    width: 88rpx;
    height: 88rpx;
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12rpx;
    box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.quick-icon-emoji {
    font-size: 40rpx;
}

.quick-entry-text {
    font-size: 24rpx;
    color: #3d4356;
    font-weight: 500;
}

/* ========== 区块标题 ========== */
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 32rpx 16rpx;
}

.section-title-wrap {
    display: flex;
    align-items: center;
}

.section-dot {
    width: 8rpx;
    height: 32rpx;
    background: linear-gradient(180deg, #4f84ff, #6a6eff);
    border-radius: 4rpx;
    margin-right: 14rpx;
}

.section-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #1f2533;
}

.section-subtitle {
    font-size: 24rpx;
    color: #9ba3b5;
}

.section-more {
    font-size: 24rpx;
    color: #4f84ff;
    font-weight: 500;
}

/* ========== 选择餐厅 ========== */
.restaurant-item {
    display: flex;
    flex-wrap: wrap;
    margin: 4rpx 16rpx 12rpx;
    gap: 16rpx 0;
}

.res-item {
    width: calc(33.33% - 16rpx);
    margin: 0 8rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #ffffff;
    border-radius: 22rpx;
    box-sizing: border-box;
    box-shadow: 0 10rpx 28rpx rgba(35, 38, 47, 0.06);
    overflow: hidden;
    transition: all 0.3s ease;
}

.res-item:active {
    transform: scale(0.96);
    box-shadow: 0 4rpx 12rpx rgba(35, 38, 47, 0.1);
}

.res-item-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24rpx 12rpx 20rpx;
    width: 100%;
    box-sizing: border-box;
}

.res-item-inner image {
    width: 80rpx;
    height: 80rpx;
    margin-bottom: 10rpx;
}

.res-name {
    font-size: 26rpx;
    font-weight: 600;
    color: #2f3342;
    margin-bottom: 4rpx;
}

.res-desc {
    font-size: 20rpx;
    color: #b0b5c3;
}

/* ========== 促销活动横幅 ========== */
.promo-section {
    display: flex;
    padding: 0 24rpx;
    gap: 16rpx;
    margin-bottom: 8rpx;
}

.promo-card {
    flex: 1;
    border-radius: 20rpx;
    padding: 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
    position: relative;
    overflow: hidden;
}

.promo-card:active {
    transform: scale(0.98);
}

.promo-left {
    background: linear-gradient(135deg, #ff9a56, #ff6b6b);
}

.promo-right {
    background: linear-gradient(135deg, #4facfe, #00c6fb);
}

.promo-info {
    display: flex;
    flex-direction: column;
    z-index: 1;
}

.promo-tag {
    font-size: 20rpx;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.2);
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    align-self: flex-start;
    margin-bottom: 8rpx;
}

.promo-title {
    font-size: 28rpx;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4rpx;
}

.promo-desc {
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.85);
}

.promo-emoji {
    font-size: 56rpx;
    z-index: 1;
}

/* ========== 今日推荐 ========== */
.recommend-scroll {
    white-space: nowrap;
    padding-left: 24rpx;
}

.recommend-list {
    display: inline-flex;
    padding-right: 24rpx;
    gap: 20rpx;
}

.recommend-card {
    display: inline-flex;
    flex-direction: column;
    width: 280rpx;
    background: #ffffff;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.recommend-card:active {
    transform: scale(0.96);
}

.recommend-img {
    width: 280rpx;
    height: 200rpx;
}

.recommend-info {
    padding: 16rpx 18rpx 20rpx;
    display: flex;
    flex-direction: column;
}

.recommend-name {
    font-size: 26rpx;
    font-weight: 600;
    color: #2b2f36;
    margin-bottom: 10rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recommend-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.recommend-price {
    font-size: 30rpx;
    font-weight: 700;
    color: #ff4757;
}

.recommend-tag-wrap {
    display: flex;
    align-items: center;
}

.recommend-tag {
    font-size: 20rpx;
    color: #ff9a56;
    background: rgba(255, 154, 86, 0.1);
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
}

/* ========== 热门排行 ========== */
.ranking-section {
    padding: 0 24rpx 12rpx;
}

.ranking-card {
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 20rpx 24rpx;
    margin-bottom: 16rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.ranking-card:active {
    transform: scale(0.98);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.ranking-index {
    width: 44rpx;
    height: 44rpx;
    border-radius: 12rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    font-weight: 700;
    color: #ffffff;
    margin-right: 20rpx;
    flex-shrink: 0;
    background: #c8cdd8;
}

.rank-1 {
    background: linear-gradient(135deg, #FFD700, #FFA500);
    box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.4);
}

.rank-2 {
    background: linear-gradient(135deg, #C0C0C0, #A8A8A8);
    box-shadow: 0 4rpx 12rpx rgba(192, 192, 192, 0.4);
}

.rank-3 {
    background: linear-gradient(135deg, #CD7F32, #B87333);
    box-shadow: 0 4rpx 12rpx rgba(205, 127, 50, 0.4);
}

.ranking-img {
    width: 120rpx;
    height: 120rpx;
    border-radius: 16rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.ranking-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.ranking-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #2b2f36;
    margin-bottom: 6rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ranking-restaurant {
    font-size: 22rpx;
    color: #9ba3b5;
    margin-bottom: 10rpx;
}

.ranking-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ranking-price {
    font-size: 30rpx;
    font-weight: 700;
    color: #ff4757;
}

.ranking-sales {
    font-size: 22rpx;
    color: #b0b5c3;
}

/* ========== 底部安全间距 ========== */
.bottom-safe {
    height: 40rpx;
}

/* ========== 弹窗遮罩 ========== */
.background {
    position: fixed;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background-color: rgba(11, 15, 22, 0.55);
    backdrop-filter: blur(6rpx);
    z-index: 100;
}

.content {
    height: 800rpx;
    position: fixed;
    background-color: #ffffff;
    width: 86%;
    top: 200rpx;
    left: 7%;
    border-radius: 36rpx;
    box-shadow: 0 30rpx 80rpx rgba(20, 24, 35, 0.25);
    z-index: 101;
    overflow: hidden;
}

.scroll-item {
    display: flex;
    flex-direction: column;
}

.modal-title {
    display: flex;
    justify-content: center;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2533;
    margin-bottom: 16rpx;
}

.content-item {
    margin: 40rpx 36rpx 30rpx;
    display: flex;
    flex-direction: column;
}

.notice-content-list {
    margin-top: 8rpx;
}

.notice-content-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 28rpx;
    padding: 20rpx 24rpx;
    background: #f6f8fc;
    border-radius: 16rpx;
}

.notice-num {
    width: 40rpx;
    height: 40rpx;
    background: linear-gradient(135deg, #4f84ff, #6a6eff);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22rpx;
    font-weight: 700;
    margin-right: 16rpx;
    flex-shrink: 0;
    line-height: 40rpx;
    text-align: center;
}

.info {
    flex: 1;
    font-size: 26rpx;
    color: #5d6472;
    line-height: 1.6;
    word-wrap: break-word;
    white-space: pre-wrap;
}

.close-btn {
    margin: 12rpx 40rpx 20rpx;
    border-radius: 40rpx;
    background: linear-gradient(135deg, #4f84ff, #6a6eff);
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    padding: 16rpx 0;
    border: none;
    box-shadow: 0 12rpx 30rpx rgba(79, 132, 255, 0.3);
}

.close-btn::after {
    border: none;
}
