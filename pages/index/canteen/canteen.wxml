<!-- 统一餐厅页面 - 通过catId区分不同餐厅 -->

<!-- 顶部头部区域 -->
<view class="page-header">
  <!-- 餐厅信息卡片 -->
  <view class="canteen-info-card">
    <view class="canteen-info-left">
      <view class="canteen-name-row">
        <text class="canteen-name">{{canteenName}}</text>
        <view class="canteen-badge">营业中</view>
      </view>
      <text class="canteen-desc">{{canteenDesc}}</text>
      <view class="canteen-meta">
        <text class="meta-item">🕐 7:00-21:00</text>
        <text class="meta-divider">|</text>
        <text class="meta-item">📍 曲江校区</text>
      </view>
    </view>
    <view class="canteen-info-right">
      <image class="canteen-avatar" src="{{canteenImage}}" mode="aspectFill" />
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <image src="/images/search.png" class="search-icon" />
    <input type="text" placeholder="搜索{{canteenName}}的美食..." confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearch" value="{{searchKey}}" />
    <view class="search-clear" wx:if="{{searchKey}}" bindtap="clearSearch">✕</view>
  </view>
</view>

<!-- 主体内容区域 -->
<view class="main-content">
  <!-- 左侧分类导航 -->
  <scroll-view scroll-y="true" class="side-nav" enhanced show-scrollbar="{{false}}">
    <view class="nav-item {{selectedStoreId == null ? 'nav-active' : ''}}" bindtap="selectStore" data-id="">
      <view class="nav-icon-wrap {{selectedStoreId == null ? 'nav-icon-active' : ''}}">
        <text class="nav-icon-text">🍽️</text>
      </view>
      <text class="nav-text">全部</text>
    </view>
    <block wx:for="{{dangkou}}" wx:key="id">
      <view class="nav-item {{selectedStoreId == item.name ? 'nav-active' : ''}}" bindtap="selectStore" data-id="{{item.name}}">
        <view class="nav-icon-wrap {{selectedStoreId == item.name ? 'nav-icon-active' : ''}}">
          <image src="/images/order_yes.png" class="nav-icon-img" mode="aspectFit" />
        </view>
        <text class="nav-text">{{item.name}}</text>
      </view>
    </block>
  </scroll-view>

  <!-- 右侧菜品列表 -->
  <scroll-view scroll-y="true" class="dish-list" enhanced show-scrollbar="{{false}}">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredMenu.length === 0}}">
      <text class="empty-emoji">🍳</text>
      <text class="empty-text">暂无菜品</text>
      <text class="empty-sub">该分类下暂时没有菜品哦~</text>
    </view>

    <!-- 菜品卡片 -->
    <block wx:for="{{filteredMenu}}" wx:key="_id">
      <view class="dish-card" bindtap="toGoodsDetail" data-id="{{item._id}}">
        <view class="dish-img-wrap">
          <image src="{{item.cover}}" mode="aspectFill" class="dish-img" />
          <view class="dish-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
        </view>
        <view class="dish-info">
          <text class="dish-name">{{item.dishname}}</text>
          <text class="dish-detail">{{item.details}}</text>
          <view class="dish-bottom">
            <view class="dish-price-wrap">
              <text class="dish-price-symbol">¥</text>
              <text class="dish-price">{{num_str.toFixedString(item.price)}}</text>
            </view>
            <view class="dish-counter">
              <view class="counter-btn counter-minus counter-active" wx:if="{{item.number > 0}}" catchtap="jian" data-id="{{item._id}}">
                <text>-</text>
              </view>
              <text class="counter-num" wx:if="{{item.number > 0}}">{{item.number}}</text>
              <view class="counter-btn counter-plus" catchtap="jia" data-id="{{item._id}}">
                <text>+</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 底部占位 -->
    <view class="list-bottom-space"></view>
  </scroll-view>
</view>

<!-- 底部购物车栏 -->
<view class="cart-bar">
  <view class="cart-bar-left" bindtap="openMask">
    <view class="cart-icon-wrap">
      <image class="cart-icon" src="/images/gouwuche.jpg" mode="aspectFill" />
      <view class="cart-badge" wx:if="{{cartList.length > 0}}">{{cartTotalCount}}</view>
    </view>
    <view class="cart-price-info">
      <text class="cart-total-label">合计</text>
      <text class="cart-total-price">¥{{num_str.toFixedString(totalmoney)}}</text>
    </view>
  </view>
  <view class="cart-bar-btn {{cartList.length > 0 ? 'cart-bar-btn-active' : ''}}" catchtap="toSettlement">
    <text>去结算</text>
  </view>
</view>

<!-- 购物车蒙层 -->
<view hidden="{{isHiddMask}}" class="mask-overlay" bindtap="closeMask"></view>

<!-- 购物车弹出层 -->
<view hidden="{{isHiddMask}}" class="cart-popup">
  <view class="cart-popup-header">
    <text class="cart-popup-title">🛒 购物车</text>
    <view class="cart-popup-actions">
      <text class="cart-clear-btn" bindtap="clearCart">清空</text>
      <text class="cart-close-btn" bindtap="closeMask">✕</text>
    </view>
  </view>

  <scroll-view class="cart-popup-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="cart-empty" wx:if="{{cartList.length === 0}}">
      <text class="cart-empty-emoji">🛒</text>
      <text class="cart-empty-text">购物车是空的~</text>
    </view>
    <block wx:for="{{cartList}}" wx:key="_id">
      <view class="cart-popup-item" wx:if="{{item.number > 0}}">
        <image src="{{item.cover}}" mode="aspectFill" class="cart-item-img" />
        <view class="cart-item-info">
          <text class="cart-item-name">{{item.dishname}}</text>
          <text class="cart-item-price">¥{{num_str.toFixedString(item.price)}}</text>
        </view>
        <view class="cart-item-counter">
          <view class="counter-btn counter-minus counter-active" catchtap="jian" data-id="{{item._id}}">
            <text>-</text>
          </view>
          <text class="counter-num">{{item.number}}</text>
          <view class="counter-btn counter-plus" catchtap="jia" data-id="{{item._id}}">
            <text>+</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>

<wxs src="../../../utils/num_str.wxs" module="num_str" />
