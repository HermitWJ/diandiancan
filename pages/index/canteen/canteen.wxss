/* ========== 统一餐厅页面样式 ========== */
page {
  background: #f3f5f9;
  height: 100%;
}

/* ========== 顶部头部区域 ========== */
.page-header {
  background: linear-gradient(135deg, #4f84ff 0%, #6a6eff 100%);
  padding: 24rpx 24rpx 30rpx;
  border-radius: 0 0 36rpx 36rpx;
  position: relative;
  z-index: 10;
}

/* 餐厅信息卡片 */
.canteen-info-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.canteen-info-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.canteen-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.canteen-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 16rpx;
}

.canteen-badge {
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(76, 217, 100, 0.85);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.canteen-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.canteen-meta {
  display: flex;
  align-items: center;
}

.meta-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.meta-divider {
  margin: 0 12rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

.canteen-info-right {
  margin-left: 24rpx;
}

.canteen-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.search-bar .search-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.4;
  margin-right: 12rpx;
}

.search-bar input {
  flex: 1;
  font-size: 26rpx;
  height: 52rpx;
  line-height: 52rpx;
  color: #333;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  background: #eee;
  border-radius: 50%;
}

/* ========== 主体内容区域 ========== */
.main-content {
  display: flex;
  flex-direction: row;
  height: calc(100vh - 380rpx - 130rpx);
  margin-top: 16rpx;
}

/* 左侧分类导航 */
.side-nav {
  width: 180rpx;
  background: #ffffff;
  border-radius: 0 20rpx 20rpx 0;
  padding: 16rpx 0;
  box-shadow: 4rpx 0 16rpx rgba(0, 0, 0, 0.03);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  position: relative;
  transition: all 0.3s ease;
}

.nav-item.nav-active {
  background: #f0f4ff;
}

.nav-item.nav-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #4f84ff, #6a6eff);
  border-radius: 0 4rpx 4rpx 0;
}

.nav-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.nav-icon-wrap.nav-icon-active {
  background: linear-gradient(135deg, #4f84ff, #6a6eff);
  box-shadow: 0 4rpx 12rpx rgba(79, 132, 255, 0.3);
}

.nav-icon-text {
  font-size: 32rpx;
}

.nav-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.nav-icon-active .nav-icon-img {
  filter: brightness(10);
}

.nav-text {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
  text-align: center;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-active .nav-text {
  color: #4f84ff;
  font-weight: 600;
}

/* ========== 右侧菜品列表 ========== */
.dish-list {
  flex: 1;
  padding: 0 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 600;
}

.empty-sub {
  font-size: 24rpx;
  color: #c0c0c0;
  margin-top: 8rpx;
}

/* 菜品卡片 */
.dish-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.dish-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.dish-img-wrap {
  position: relative;
  flex-shrink: 0;
}

.dish-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
}

.dish-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2f36;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-detail {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.dish-price-wrap {
  display: flex;
  align-items: baseline;
}

.dish-price-symbol {
  font-size: 22rpx;
  color: #ff4757;
  font-weight: 600;
}

.dish-price {
  font-size: 32rpx;
  color: #ff4757;
  font-weight: 700;
}

/* 数量计数器 */
.dish-counter {
  display: flex;
  align-items: center;
}

.counter-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.counter-minus {
  background: #fff0f0;
  color: #ff4757;
  border: 2rpx solid #ffcdd2;
}

.counter-plus {
  background: linear-gradient(135deg, #4f84ff, #6a6eff);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(79, 132, 255, 0.3);
}

.counter-plus:active {
  transform: scale(0.9);
}

.counter-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  min-width: 48rpx;
  text-align: center;
}

.list-bottom-space {
  height: 40rpx;
}

/* ========== 底部购物车栏 ========== */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
  padding: 0 0 0 20rpx;
}

.cart-bar-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon-wrap {
  position: relative;
  width: 90rpx;
  height: 90rpx;
  margin-right: 16rpx;
}

.cart-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.4);
}

.cart-price-info {
  display: flex;
  flex-direction: column;
}

.cart-total-label {
  font-size: 22rpx;
  color: #999;
}

.cart-total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.cart-bar-btn {
  width: 230rpx;
  height: 120rpx;
  background: #c8cdd8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.cart-bar-btn-active {
  background: linear-gradient(135deg, #ff9a56, #ff6b6b);
  box-shadow: -4rpx 0 20rpx rgba(255, 107, 107, 0.2);
}

/* ========== 购物车弹出层 ========== */
.mask-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.cart-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  max-height: 700rpx;
  background: #ffffff;
  z-index: 200;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.cart-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.cart-popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.cart-popup-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cart-clear-btn {
  font-size: 26rpx;
  color: #ff4757;
  font-weight: 500;
}

.cart-close-btn {
  font-size: 32rpx;
  color: #999;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.cart-popup-list {
  max-height: 600rpx;
  padding: 8rpx 0;
}

/* 购物车空状态 */
.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.cart-empty-emoji {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.cart-empty-text {
  font-size: 26rpx;
  color: #ccc;
}

/* 购物车条目 */
.cart-popup-item {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.cart-item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cart-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cart-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cart-item-price {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: 600;
  margin-top: 6rpx;
}

.cart-item-counter {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
