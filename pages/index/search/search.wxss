/* ===== 搜索美食页面 - 精美设计 ===== */

page {
  background: #f5f6fa;
}

.search-page {
  min-height: 100vh;
}

/* ===== 顶部搜索栏 ===== */
.search-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
}

.search-bar-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 44rpx;
  line-height: 44rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  font-size: 22rpx;
  color: #fff;
  margin-left: 8rpx;
}

.search-action {
  font-size: 30rpx;
  color: #ff6b35;
  font-weight: 600;
  flex-shrink: 0;
  padding: 8rpx 12rpx;
}

/* ===== 搜索发现区域 ===== */
.discover-section {
  padding: 20rpx 24rpx;
}

.discover-block {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.discover-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.discover-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
}

/* 标签云 */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  transition: all 0.2s;
}

.tag-item:active {
  transform: scale(0.95);
}

.hot-tag {
  background: linear-gradient(135deg, #fff5f0, #fff0e8);
  color: #ff6b35;
  border: 1rpx solid rgba(255, 107, 53, 0.15);
}

.hot-rank {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  margin-right: 10rpx;
}

.history-tag {
  background: #f5f6fa;
  color: #666;
  border: 1rpx solid #eee;
}

/* 温馨提示 */
.search-tip-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
}

.tip-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.tip-sub {
  font-size: 24rpx;
  color: #bbb;
}

/* ===== 搜索结果区域 ===== */
.result-section {
  padding: 0 24rpx 40rpx;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #ff6b35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 结果统计 */
.result-summary {
  padding: 24rpx 4rpx 16rpx;
}

.result-count {
  font-size: 26rpx;
  color: #999;
}

.count-highlight {
  color: #ff6b35;
  font-weight: 700;
  font-size: 30rpx;
}

/* 搜索结果卡片 */
.result-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.result-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.result-img-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.result-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}

.result-store-tag {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(4px);
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 200rpx;
  padding: 4rpx 0;
}

.result-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.result-desc {
  font-size: 24rpx;
  color: #999;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.result-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 700;
}

.price-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #ff6b35;
  margin-left: 2rpx;
}

.result-action {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  border-radius: 24rpx;
}

.action-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* ===== 空结果 ===== */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #bbb;
}
