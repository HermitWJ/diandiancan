/* ========== 商品详情页 - 现代化设计 ========== */
page {
  background: #f3f5f9;
}

.detail-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 顶部大图区域 ========== */
.hero-section {
  position: relative;
  width: 100%;
  height: 600rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.05));
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 80rpx;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.back-icon {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

/* 分享浮动按钮 */
.share-float-btn {
  position: absolute;
  top: 80rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.share-icon {
  width: 32rpx;
  height: 32rpx;
}

.share-real-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

/* ========== 商品信息卡片 ========== */
.info-card {
  margin: -60rpx 20rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 5;
  overflow: hidden;
}

.info-card-top {
  padding: 32rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: 700;
  margin-right: 4rpx;
}

.price-value {
  font-size: 52rpx;
  color: #ff4757;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.collect-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

.collect-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.collect-text {
  font-size: 20rpx;
  color: #999;
}

.goods-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2b2f36;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  font-size: 22rpx;
  color: #4f84ff;
  background: rgba(79, 132, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-hot {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.1);
}

/* ========== 通用区块卡片 ========== */
.section-card {
  margin: 20rpx 20rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.section-indicator {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #4f84ff, #6a6eff);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2f36;
  flex: 1;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.section-body {
  padding: 24rpx 32rpx;
}

/* 商品详情行 */
.detail-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* ========== 评价区域 ========== */

/* 评分概览 */
.rate-overview {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #fff8f0, #fff3e6);
  border-bottom: 2rpx solid #f5f5f5;
}

.rate-overview-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  padding-right: 32rpx;
  border-right: 2rpx solid #f0e0d0;
}

.rate-overview-score {
  font-size: 56rpx;
  font-weight: 800;
  color: #ff6b35;
  line-height: 1.2;
}

.rate-overview-stars {
  display: flex;
  gap: 4rpx;
  margin-top: 8rpx;
}

.mini-star {
  font-size: 24rpx;
  color: #e0e0e0;
}

.mini-star-active {
  color: #ffb800;
}

.rate-overview-right {
  display: flex;
  flex-direction: column;
}

.rate-overview-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.rate-overview-desc {
  font-size: 22rpx;
  color: #999;
}

.no-evaluate {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.no-evaluate-emoji {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.no-evaluate-text {
  font-size: 26rpx;
  color: #ccc;
}

.evaluate-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f8f8f8;
}

.evaluate-item:last-child {
  border-bottom: none;
}

.evaluate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.evaluate-user {
  display: flex;
  align-items: center;
}

.evaluate-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.evaluate-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.evaluate-user-info {
  display: flex;
  flex-direction: column;
}

.evaluate-stars {
  display: flex;
  gap: 2rpx;
  margin-top: 6rpx;
}

.eval-star {
  font-size: 22rpx;
  color: #e0e0e0;
}

.eval-star-on {
  color: #ffb800;
}

.evaluate-time {
  font-size: 22rpx;
  color: #c0c0c0;
}

.evaluate-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 16rpx;
  display: block;
}

.evaluate-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.evaluate-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
}

/* ========== 底部占位 ========== */
.bottom-space {
  height: 180rpx;
}

/* ========== 底部操作栏 ========== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
  padding: 0 20rpx;
}

.action-right {
  flex: 1;
  display: flex;
  height: 80rpx;
  border-radius: 40rpx;
  overflow: hidden;
}

.action-cart-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f84ff, #6a6eff);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  gap: 6rpx;
}

.action-cart-btn:active {
  opacity: 0.85;
}

.action-buy-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff6b6b, #ff4757);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  gap: 6rpx;
}

.action-buy-btn:active {
  opacity: 0.85;
}

.action-btn-icon {
  font-size: 28rpx;
}

.action-cart-btn text,
.action-buy-btn text {
  color: #ffffff;
  font-weight: 600;
}
