/* ===== 订单页面全新设计样式 ===== */

/* 全局背景 */
page {
  background-color: #f5f5f8;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 顶部搜索栏 ===== */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
  margin-right: 20rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  font-size: 22rpx;
  color: #fff;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.search-btn {
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  border-radius: 36rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.search-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.msg-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 搜索提示栏 ===== */
.search-hint {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.hint-text {
  font-size: 26rpx;
  color: #999;
}

.search-result-bar {
  padding: 16rpx 28rpx 0;
}

.search-result-text {
  font-size: 24rpx;
  color: #999;
}

.search-result-num {
  color: #ff6b35;
  font-weight: 700;
  font-size: 28rpx;
}

/* ===== 搜索下拉面板 ===== */
.search-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 200;
}

.search-dropdown {
  position: fixed;
  top: 120rpx;
  left: 0;
  right: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  z-index: 201;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.search-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-dot {
  font-size: 28rpx;
  color: #ff6b35;
  margin-right: 12rpx;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.search-empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-search-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-search-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-search-sub {
  font-size: 24rpx;
  color: #bbb;
}

.search-result-count {
  padding: 20rpx 28rpx 12rpx;
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #f0f0f0;
}

.count-num {
  color: #ff6b35;
  font-weight: 700;
  font-size: 28rpx;
}

.search-result-scroll {
  max-height: 60vh;
}

.search-result-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.15s;
}

.search-result-item:active {
  background: #faf5f2;
}

.result-left {
  flex: 1;
  min-width: 0;
}

.result-shop-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-shop-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.result-shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-dish-row {
  margin-bottom: 6rpx;
}

.result-dish-text {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta-row {
  display: flex;
  align-items: center;
}

.result-time {
  font-size: 22rpx;
  color: #bbb;
  margin-right: 16rpx;
}

.result-order-id {
  font-size: 20rpx;
  color: #ccc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.result-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.result-status--1 {
  background: #fff3e6;
  color: #ff8c00;
}

.result-status-0 {
  background: #e6f7ff;
  color: #1890ff;
}

.result-status-1 {
  background: #f0ffe6;
  color: #52c41a;
}

.result-status-2 {
  background: #fff0f6;
  color: #eb2f96;
}

.result-status-3 {
  background: #f5f5f5;
  color: #999;
}

.result-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b35;
}

.result-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-top: 4rpx;
}

/* ===== 搜索选中订单详情横幅 ===== */
.selected-order-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #fff8f4, #fff1eb);
  border-bottom: 1rpx solid #ffe4d4;
}

.selected-order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b35;
}

.selected-order-close {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 24rpx;
  background: #fff;
}

.selected-order-close:active {
  background: #f5f5f5;
}

.order-card-highlight {
  border: 2rpx solid #ff6b35;
  box-shadow: 0 4rpx 24rpx rgba(255, 107, 53, 0.15);
}

/* ===== 状态标签栏 ===== */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 8rpx 0 0 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: #999;
  position: relative;
  transition: all 0.3s;
}

.tab-active {
  color: #333;
  font-weight: 600;
}

.tab-line {
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #ff6b35, #ff9a56);
  border-radius: 3rpx;
  margin-top: 8rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #ccc;
}

/* ===== 订单卡片 ===== */
.order-card {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* ===== 卡片头部 ===== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.shop-info {
  display: flex;
  align-items: center;
}

.shop-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.shop-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 状态标签 */
.status-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status--1 {
  background: #fff3e6;
  color: #ff8c00;
}

.status-0 {
  background: #e6f7ff;
  color: #1890ff;
}

.status-1 {
  background: #f0ffe6;
  color: #52c41a;
}

.status-2 {
  background: #fff0f6;
  color: #eb2f96;
}

.status-3 {
  background: #f5f5f5;
  color: #999;
}

/* ===== 取餐号高亮区域 ===== */
.pickup-banner {
  margin: 20rpx 28rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  border-radius: 20rpx;
  padding: 30rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pickup-inner {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.pickup-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-right: 16rpx;
}

.pickup-number {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.pickup-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* ===== 菜品列表 ===== */
.dish-list {
  padding: 16rpx 28rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 120rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.dish-desc {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.dish-qty {
  font-size: 26rpx;
  color: #999;
}

.dish-price-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dish-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.eva-btn {
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border: 2rpx solid #ff6b35;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #ff6b35;
}

/* ===== 费用明细区域 ===== */
.fee-section {
  margin: 0 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.fee-label {
  font-size: 26rpx;
  color: #999;
}

.fee-value {
  font-size: 26rpx;
  color: #666;
}

.fee-discount {
  color: #ff6b35;
  font-weight: 500;
}

.fee-total {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eee;
}

.fee-total-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}

.fee-total-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff6b35;
}

/* ===== 订单详情信息区 ===== */
.order-detail-section {
  margin: 0 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.detail-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  width: 36rpx;
  text-align: center;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.remark-value {
  color: #ff6b35;
  font-weight: 500;
}

.order-id-text {
  font-size: 22rpx;
  color: #b0b0b0;
  word-break: break-all;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-left {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  width: auto;
  max-width: 200rpx;
}

.contact-btn {
  display: inline-flex !important;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1;
  background: transparent !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: 180rpx;
  box-sizing: border-box;
}

.contact-btn::after {
  border: none;
}

.contact-icon {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.action-right {
  display: flex;
  align-items: center;
}

.action-btn {
  padding: 12rpx 16rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 10rpx;
  transition: all 0.2s;
  white-space: nowrap;
  flex-shrink: 0;
}

.action-btn-ghost {
  background: #fff;
  color: #999;
  border: 2rpx solid #ddd;
}

.action-btn-primary {
  background: linear-gradient(135deg, #ff6b35, #ff9a56);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.action-btn-warn {
  background: linear-gradient(135deg, #ffa940, #ffc53d);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 169, 64, 0.3);
}

/* ===== 底部安全区 ===== */
.safe-bottom {
  height: 40rpx;
}


