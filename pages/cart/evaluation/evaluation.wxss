/* ========== 评价页面全局 ========== */
page {
  background-color: #f5f6fa;
  padding-bottom: env(safe-area-inset-bottom);
}

.eval-page {
  padding: 0 24rpx;
  padding-top: 20rpx;
  position: relative;
}

/* ========== 顶部渐变背景 ========== */
.top-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, #fff3ec 0%, #f5f6fa 100%);
  z-index: -1;
}

/* ========== 卡片通用样式 ========== */
.goods-card,
.rate-card,
.content-card,
.upload-card,
.anonymous-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

/* ========== 商品信息卡片 ========== */
.goods-card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2f36;
  margin-bottom: 24rpx;
}

.goods-card-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.goods-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-store {
  font-size: 24rpx;
  color: #999;
}

/* ========== 星级评分区 ========== */
.rate-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.rate-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2f36;
  margin-bottom: 32rpx;
}

.rate-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.rate-stars {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.star-item {
  padding: 8rpx;
}

.star {
  font-size: 72rpx;
  transition: all 0.2s ease;
}

.star-default {
  color: #e0e0e0;
}

.star-active {
  color: #ffb800;
  text-shadow: 0 4rpx 12rpx rgba(255, 184, 0, 0.3);
  transform: scale(1.1);
}

.rate-desc {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: 500;
  margin-top: 8rpx;
}

/* ========== 评价内容区 ========== */
.content-header {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2f36;
  margin-bottom: 24rpx;
}

.content-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.textarea-wrapper {
  background: #f8f9fc;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  border: 2rpx solid #f0f1f5;
  transition: border-color 0.3s;
}

.textarea-wrapper:focus-within {
  border-color: #ff6b35;
}

.eval-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.textarea-placeholder {
  color: #c0c4cc;
  font-size: 28rpx;
}

.word-count {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}

.count-full {
  color: #ff6b35;
}

.count-divider {
  margin: 0 4rpx;
}

/* ========== 快捷标签 ========== */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tag-item {
  padding: 12rpx 28rpx;
  background: #f5f6fa;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-selected {
  background: #fff5f0;
  color: #ff6b35;
  border-color: #ff6b35;
  font-weight: 500;
}

/* ========== 图片上传区 ========== */
.upload-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.upload-title-row {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2f36;
}

.upload-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.upload-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f6fa;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-img-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.upload-add-btn {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border: 3rpx dashed #d8dce6;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafbfc;
  transition: all 0.2s;
}

.upload-add-btn:active {
  background: #f0f1f5;
  border-color: #ff6b35;
}

.add-icon {
  font-size: 56rpx;
  color: #c0c4cc;
  line-height: 1;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #c0c4cc;
}

.upload-tip {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 20rpx;
  display: block;
}

/* ========== 匿名评价 ========== */
.anonymous-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.anonymous-left {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.anonymous-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

/* ========== 底部占位 ========== */
.bottom-space {
  height: 180rpx;
}

/* ========== 底部发布按钮 ========== */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  transition: all 0.3s;
}

.submit-active {
  background: linear-gradient(135deg, #ff6b35, #ff8f5e);
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.35);
}

.submit-active:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.25);
}

.submit-disabled {
  background: #d8dce6;
}

.submit-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}
