<view>
  <view class="shop-item">
    <block wx:for="{{item.Detail}}" wx:key="id" wx:for-item="Detail">
      <!-- 若出现数组包含数组的情况，可以使用wx:for-item="Detail"重新定义名字，这样在内层数组甚至可以使用外层数组的内容 -->
      <view class="Title">
        <text class="title">{{Detail.StoreName}}</text>
      </view>
      <view class="list">
        <view class="text-item">
          <text>{{Detail.dishname}}</text>
          <text class="number">X1</text>
        </view>
        <view class="price-item">
          <text class="price">￥{{Detail.price}}</text>
          <view class="eva" wx:if="{{item.Status==2}}">
            <text class="tabbar-item" bindtap="navigateToOrders" data-id="{{Detail._id}}">评价</text>
          </view>
        </view>
      </view>
      <view class="total">
        <view class="dingdan">
          <text>订单号：</text>
          <text class="_id">{{item._id}}</text>
        </view>
        <view class="total1">
          <text>打包费</text>
          <text>￥0</text>
        </view>
        <view class="total1">
          <text>服务费</text>
          <text>￥0</text>
        </view>
        <view class="total2">
          <view class="text1">
            <text>已优惠</text>
            <text class="text2">￥0</text>
          </view>
          <view>
            <text>合计</text>
            <text class="text3">￥15.00</text>
          </view>
        </view>
      </view>
    </block>
  </view>
  <view class="shop-item">
    <text class="title">退款信息</text>
    <view class="tuikuan">
      <text>退款原因</text>
      <text>退款金额</text>
    </view>
  </view>
  <view class="shop-item">
    <text class="title">补充描述和凭证</text>
    <view class="tuikuan">
      <text>退款原因</text>
      <text>退款金额</text>
    </view>
  </view>
</view>