/* pages/mycoupon/mycoupon.wxss */
page {
  background: #f5f5f8;
  min-height: 100vh;
}

/* ========== 标签切换 ========== */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 60rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 20rpx;
  font-size: 30rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #ff4757;
  font-weight: bold;
}

.tab-line {
  width: 48rpx;
  height: 6rpx;
  background: #ff4757;
  border-radius: 3rpx;
  margin-top: 10rpx;
}

/* ========== 优惠券列表 ========== */
.coupon-list {
  padding: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.coupon-card.expired {
  opacity: 0.5;
}

/* 左侧金额 */
.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  flex-shrink: 0;
}

.coupon-card.expired .coupon-left {
  background: linear-gradient(135deg, #bbb 0%, #ddd 100%);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.amount-unit {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}

.amount-num {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.coupon-condition {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 虚线分隔 */
.coupon-divider-wrap {
  width: 1rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.half-circle {
  width: 24rpx;
  height: 12rpx;
  background: #f5f5f8;
  position: absolute;
}

.half-circle.top {
  top: -1rpx;
  border-radius: 0 0 12rpx 12rpx;
}

.half-circle.bottom {
  bottom: -1rpx;
  border-radius: 12rpx 12rpx 0 0;
}

.dash-line {
  width: 1rpx;
  height: 100%;
  background: repeating-linear-gradient(
    to bottom,
    #eee 0,
    #eee 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

/* 右侧信息 */
.coupon-right {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.use-btn {
  align-self: flex-end;
  padding: 10rpx 32rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  margin-top: 12rpx;
}

.expired-tag {
  align-self: flex-end;
  padding: 8rpx 24rpx;
  background: #eee;
  color: #999;
  font-size: 22rpx;
  border-radius: 20rpx;
  margin-top: 12rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-btn {
  margin-top: 30rpx;
  padding: 14rpx 50rpx;
  background: linear-gradient(135deg, #ff4757, #ff6b81);
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(255,71,87,0.25);
}
