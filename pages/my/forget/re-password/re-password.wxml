<!-- 顶部装饰 -->
<view class="forget-header">
  <view class="forget-header-bg"></view>
  <view class="forget-header-content">
    <text class="forget-header-icon">🔄</text>
    <view class="forget-title">重置密码</view>
    <view class="forget-subtitle">设置你的新密码</view>
  </view>
</view>

<!-- 进度提示 -->
<view class="progress-tip">
  <view class="progress-dot progress-done"></view>
  <view class="progress-line progress-done-line"></view>
  <view class="progress-dot progress-done"></view>
  <view class="progress-line progress-done-line2"></view>
  <view class="progress-dot progress-active"></view>
  <view class="progress-labels">
    <text class="label-done">输入手机号</text>
    <text class="label-done">密保验证</text>
    <text class="label-active">重置密码</text>
  </view>
</view>

<!-- 密码设置卡片 -->
<view class="main-card">
  <view class="card-title-row">
    <text class="card-icon">🔒</text>
    <text class="card-title">设置新密码</text>
  </view>
  <view class="card-desc">新密码建议使用字母+数字组合，长度不少于6位</view>

  <view class="input-group">
    <view class="input-row">
      <text class="input-emoji">🔑</text>
      <input bindinput="inputvalues1" type="password" placeholder="请输入新密码" class="input-field" placeholder-class="placeholder-style" />
    </view>
    <view class="input-divider"></view>
    <view class="input-row">
      <text class="input-emoji">✅</text>
      <input bindinput="inputvalues2" type="password" placeholder="请确认新密码" class="input-field" placeholder-class="placeholder-style" />
    </view>
  </view>

  <button class="submit-btn" bindtap="re_password">
    <text class="submit-btn-text">确认修改</text>
  </button>
</view>

<!-- 安全提示 -->
<view class="security-notice">
  <text class="notice-icon">⚠️</text>
  <view class="notice-content">
    <text class="notice-title">温馨提示</text>
    <text class="notice-text">修改密码后，你需要使用新密码重新登录</text>
  </view>
</view>
