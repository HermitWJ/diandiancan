/* ===== 忘记密码页全局 ===== */
page {
  background: #f5f6fa;
  min-height: 100vh;
}

/* ===== 顶部装饰 ===== */
.forget-header {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.forget-header-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f60 50%, #ffa726 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.forget-header-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.forget-header-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.forget-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.forget-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* ===== 主体卡片 ===== */
.main-card {
  margin: -30rpx 32rpx 0;
  padding: 40rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* ===== 输入框组 ===== */
.input-group {
  background: #f8f9fc;
  border-radius: 20rpx;
  border: 2rpx solid #eef0f5;
  overflow: hidden;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.input-prefix {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  flex-shrink: 0;
}

.input-separator {
  width: 2rpx;
  height: 36rpx;
  background: #ddd;
  margin: 0 24rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.placeholder-style {
  color: #c0c4cc;
  font-size: 28rpx;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f60 50%, #ffa726 100%) !important;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
  padding: 0;
  line-height: 96rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.97);
}

.submit-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.submit-btn-arrow {
  color: #fff;
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* ===== 帮助提示 ===== */
.help-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.help-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.help-text {
  font-size: 24rpx;
  color: #bbb;
}
