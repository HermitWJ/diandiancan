/* ===== 密保验证页全局 ===== */
page {
  background: #f5f6fa;
  min-height: 100vh;
}

/* ===== 顶部装饰 ===== */
.forget-header {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.forget-header-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f60 50%, #ffa726 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.forget-header-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.forget-header-icon {
  font-size: 72rpx;
  margin-bottom: 8rpx;
}

.forget-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.forget-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* ===== 进度条 ===== */
.progress-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 60rpx 0;
  position: relative;
}

.progress-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ddd;
  flex-shrink: 0;
  z-index: 2;
}

.progress-done {
  background: #43a047;
}

.progress-active {
  background: linear-gradient(135deg, #ff6b35, #ffa726);
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.4);
  width: 28rpx;
  height: 28rpx;
}

.progress-line {
  flex: 1;
  height: 4rpx;
  background: #ddd;
}

.progress-done-line {
  background: linear-gradient(90deg, #43a047, #ffa726);
}

.progress-labels {
  position: absolute;
  top: 60rpx;
  left: 40rpx;
  right: 40rpx;
  display: flex;
  justify-content: space-between;
}

.label-done {
  font-size: 20rpx;
  color: #43a047;
  font-weight: 500;
}

.label-active {
  font-size: 20rpx;
  color: #ff6b35;
  font-weight: 600;
}

.label-pending {
  font-size: 20rpx;
  color: #bbb;
}

/* ===== 密保卡片 ===== */
.mibao-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.mibao-card:first-of-type {
  margin-top: 56rpx;
}

.mibao-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.mibao-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.mibao-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.question-text {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #eee;
  margin-bottom: 16rpx;
}

.answer-input-group {
  background: #f8f9fc;
  border-radius: 16rpx;
  border: 2rpx solid #eef0f5;
  overflow: hidden;
}

.answer-input-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
}

.answer-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.placeholder-style {
  color: #c0c4cc;
  font-size: 26rpx;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  margin: 40rpx 32rpx 60rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f60 50%, #ffa726 100%) !important;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
  padding: 0;
  line-height: 96rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.97);
}

.submit-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
