/* pages/my/coupon/coupon.wxss */
page {
  background: #f5f5f8;
  min-height: 100vh;
}

/* ========== 顶部横幅 ========== */
.banner {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 100%;
  background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
  border-radius: 0 0 50rpx 50rpx;
}

.banner-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 12rpx;
  letter-spacing: 3rpx;
}

/* ========== 我的优惠券入口 ========== */
.my-coupon-entry {
  margin: -30rpx 32rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 5;
}

.entry-left {
  display: flex;
  align-items: center;
}

.entry-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.entry-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.entry-badge {
  background: #ff4757;
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  padding: 0 10rpx;
}

.entry-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ========== 标题栏 ========== */
.section-title {
  padding: 40rpx 32rpx 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* ========== 优惠券卡片 ========== */
.coupon-list {
  padding: 0 32rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  transition: all 0.3s;
}

.coupon-card.claimed {
  opacity: 0.6;
}

/* 左侧金额 */
.coupon-left {
  width: 220rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.coupon-card.claimed .coupon-left {
  background: linear-gradient(135deg, #bbb 0%, #ddd 100%);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.amount-unit {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.amount-num {
  font-size: 64rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.coupon-condition {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 虚线分隔 */
.coupon-divider {
  width: 1rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.divider-circle {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #f5f5f8;
  position: absolute;
}

.divider-circle.top {
  top: -12rpx;
}

.divider-circle.bottom {
  bottom: -12rpx;
}

.divider-line {
  width: 1rpx;
  height: 100%;
  background: repeating-linear-gradient(
    to bottom,
    #eee 0,
    #eee 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

/* 右侧信息 */
.coupon-right {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.coupon-btn {
  align-self: flex-end;
  padding: 10rpx 32rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  margin-top: 12rpx;
}

.coupon-btn.btn-disabled {
  background: linear-gradient(135deg, #bbb 0%, #ddd 100%);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}
