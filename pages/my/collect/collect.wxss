/* pages/collect/collect.wxss */
page {
  background: #f5f5f8;
  min-height: 100vh;
}

.collect-page {
  padding-bottom: 40rpx;
}

/* ========== 顶部信息栏 ========== */
.header-bar {
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-info {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.header-count {
  font-size: 26rpx;
  color: #999;
}

/* ========== 收藏列表 ========== */
.collect-list {
  padding: 24rpx 24rpx 0;
}

.collect-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
}

/* 菜品图片 */
.card-img-wrap {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.card-img {
  width: 100%;
  height: 100%;
}

.card-price-tag {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  background: rgba(255,71,87,0.9);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 菜品信息 */
.card-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.card-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  margin-top: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #888;
}

.card-desc {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 取消收藏按钮 */
.card-action {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 36rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.empty-btn {
  margin-top: 40rpx;
  padding: 16rpx 60rpx;
  background: linear-gradient(135deg, #ff4757, #ff6b81);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255,71,87,0.3);
}
