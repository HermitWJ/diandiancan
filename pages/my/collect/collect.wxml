<!--pages/collect/collect.wxml-->
<view class="collect-page">
  <!-- 顶部信息栏 -->
  <view class="header-bar">
    <view class="header-info">
      <text class="header-icon">⭐</text>
      <text class="header-count">共 {{dataObj.length || 0}} 道收藏</text>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="collect-list" wx:if="{{dataObj.length > 0}}">
    <view class="collect-card" wx:for="{{dataObj}}" wx:key="_id" bind:tap="goDetail" data-id="{{item.id}}">
      <!-- 菜品图片 -->
      <view class="card-img-wrap">
        <image class="card-img" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="card-price-tag">¥{{item.price}}</view>
      </view>
      <!-- 菜品信息 -->
      <view class="card-info">
        <text class="card-name">{{item.dishname}}</text>
        <view class="card-meta">
          <view class="meta-item" wx:if="{{item.StoreName}}">
            <text class="meta-icon">🏪</text>
            <text class="meta-text">{{item.StoreName}}</text>
          </view>
          <view class="meta-item" wx:if="{{item.dangkou}}">
            <text class="meta-icon">📍</text>
            <text class="meta-text">{{item.dangkou}}</text>
          </view>
        </view>
        <text class="card-desc" wx:if="{{item.details}}">{{item.details}}</text>
      </view>
      <!-- 取消收藏按钮 -->
      <view class="card-action" catch:tap="cancelCollect" data-collectid="{{item._id}}" data-index="{{index}}">
        <text class="action-icon">❤️</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{dataObj.length === 0 && loaded}}">
    <text class="empty-icon">💔</text>
    <text class="empty-title">暂无收藏</text>
    <text class="empty-sub">去发现美食，收藏你的心头好吧~</text>
    <view class="empty-btn" bind:tap="goHome">
      <text>去逛逛</text>
    </view>
  </view>
</view>
