/* pages/my/my.wxss */
page {
  background: #f5f5f8;
  min-height: 100vh;
}

.my-page {
  padding-bottom: 60rpx;
}

/* ========== 顶部个人信息区 ========== */
.profile-header {
  position: relative;
  padding-bottom: 80rpx;
}

.profile-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 380rpx;
  background: linear-gradient(180deg, #C62828 0%, #ff4757 100%);
  border-radius: 0 0 50rpx 50rpx;
}

.profile-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 0;
}

.avatar-wrap {
  position: relative;
  margin-right: 28rpx;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.15);
}

.online-dot {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 24rpx;
  height: 24rpx;
  background: #2ed573;
  border-radius: 50%;
  border: 4rpx solid #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.verify-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.verify-icon {
  font-size: 20rpx;
  color: #2ed573;
  margin-right: 6rpx;
  font-weight: bold;
}

.verify-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
}

/* ========== 统计数据条 ========== */
.stats-bar {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 32rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* ========== 快捷功能区 ========== */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx 24rpx 0;
  justify-content: space-between;
}

.action-card {
  width: 48%;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.action-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.action-emoji {
  font-size: 36rpx;
}

.action-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.action-desc {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* ========== 服务功能列表 ========== */
.service-panel {
  margin: 30rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.panel-title {
  padding: 24rpx 32rpx 8rpx;
}

.panel-title-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.service-list {
  padding: 0;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-left {
  display: flex;
  align-items: center;
}

.service-emoji {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.service-name {
  font-size: 28rpx;
  color: #333;
}

.service-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ========== 登录/退出按钮 ========== */
.auth-section {
  padding: 40rpx 32rpx 0;
}

.auth-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.login-btn {
  background: linear-gradient(135deg, #C62828, #ff4757);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(198,40,40,0.3);
}

.logout-btn {
  background: #fff;
  color: #999;
  border: 2rpx solid #eee;
}
