<!--pages/randomeat1/randomeat1.wxml-->
<view class="random-page">
  <!-- 顶部装饰 -->
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-emoji">🎰</text>
      <text class="header-title">今天吃什么？</text>
      <text class="header-sub">选择困难症终结者 · 命运交给它</text>
    </view>
  </view>

  <!-- 随机结果展示区 -->
  <view class="slot-machine">
    <!-- 未开始状态 -->
    <view class="slot-placeholder" wx:if="{{!result && !rolling}}">
      <text class="placeholder-icon">🎲</text>
      <text class="placeholder-text">点击下方按钮开始随机</text>
    </view>

    <!-- 滚动动画 -->
    <view class="slot-rolling" wx:if="{{rolling}}">
      <view class="rolling-card">
        <image class="rolling-img" src="{{rollingItem.cover}}" mode="aspectFill"></image>
        <text class="rolling-name">{{rollingItem.dishname}}</text>
      </view>
    </view>

    <!-- 结果展示（点击跳转详情页） -->
    <view class="result-card" wx:if="{{result && !rolling}}" bind:tap="goDetail">
      <view class="result-badge">🎉 命运之选</view>
      <image class="result-img" src="{{result.cover}}" mode="aspectFill"></image>
      <view class="result-info">
        <text class="result-name">{{result.dishname}}</text>
        <view class="result-tags">
          <text class="tag tag-store">📍 {{result.StoreName}}</text>
          <text class="tag tag-price">💰 ¥{{result.price}}</text>
        </view>
        <text class="result-desc" wx:if="{{result.details}}">{{result.details}}</text>
      </view>
      <view class="result-tip">
        <text class="result-tip-text">👆 点击查看详情</text>
      </view>
    </view>
  </view>

  <!-- 随机按钮 -->
  <view class="action-section">
    <view class="random-btn {{rolling ? 'disabled' : ''}}" bind:tap="startRandom">
      <text class="btn-icon">🎲</text>
      <text class="btn-text">{{rolling ? '选择中...' : (result ? '再来一次' : '开始随机')}}</text>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="history-section" wx:if="{{historyList.length > 0}}">
    <view class="section-header">
      <text class="section-title">📋 历史记录</text>
      <text class="section-clear" bind:tap="clearHistory">清空</text>
    </view>
    <scroll-view scroll-x class="history-scroll">
      <view class="history-item" wx:for="{{historyList}}" wx:key="index" bind:tap="goHistoryDetail" data-index="{{index}}">
        <image class="history-img" src="{{item.cover}}" mode="aspectFill"></image>
        <text class="history-name">{{item.dishname}}</text>
        <text class="history-price">¥{{item.price}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部提示 -->
  <view class="tips-section">
    <text class="tips-text">💡 从所有餐厅菜品中随机推荐</text>
  </view>
</view>
