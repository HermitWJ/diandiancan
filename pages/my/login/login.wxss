/* ===== 登录页全局 ===== */
page {
  background: #f5f6fa;
  min-height: 100vh;
}

/* ===== 顶部波浪背景 ===== */
.wave-header {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.wave-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f60 50%, #ffa726 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

.brand-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  animation: bounceIn 0.8s ease;
}

@keyframes bounceIn {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.wave-shape {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 100%;
  height: 80rpx;
}

.wave {
  position: absolute;
  bottom: 0;
  left: -5%;
  width: 110%;
  height: 80rpx;
  border-radius: 50% 50% 0 0;
}

.wave1 {
  background: rgba(245, 246, 250, 0.5);
  bottom: 10rpx;
}

.wave2 {
  background: #f5f6fa;
  bottom: 0;
}

/* ===== 主体内容 ===== */
.login-body {
  padding: 0 40rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
}

/* ===== Tab 切换栏 ===== */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  position: relative;
  opacity: 0.5;
  transition: all 0.3s ease;
}

.tab-active {
  opacity: 1;
}

.tab-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #ff6b35, #ffa726);
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { width: 0; }
  to { width: 48rpx; }
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.form-content {
  animation: fadeUp 0.4s ease;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 输入框组 ===== */
.input-group {
  background: #f8f9fc;
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid #eef0f5;
  transition: border-color 0.3s;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.input-divider {
  height: 1rpx;
  background: #eef0f5;
  margin: 0 28rpx;
}

.input-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #fff3ed, #ffe8db);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.input-icon {
  width: 32rpx;
  height: 32rpx;
}

.input-field {
  flex: 1;
  padding: 12rpx 20rpx;
  font-size: 30rpx;
  color: #333;
}

.placeholder-style {
  color: #c0c4cc;
  font-size: 28rpx;
}

.eye-btn {
  padding: 12rpx;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ===== 登录按钮 ===== */
.login-btn {
  width: 100% !important;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f60 50%, #ffa726 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
  transition: all 0.3s ease;
  padding: 0;
  line-height: 96rpx;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.25);
}

.cook-btn {
  background: linear-gradient(135deg, #43a047 0%, #66bb6a 50%, #81c784 100%);
  box-shadow: 0 8rpx 24rpx rgba(67, 160, 71, 0.35);
}

.login-btn-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

/* ===== 表单底部链接 ===== */
.form-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 36rpx;
  padding: 0 8rpx;
}

.forget-link {
  font-size: 26rpx;
  color: #999;
}

.forget-link:active {
  color: #ff6b35;
}

.register-link {
  display: flex;
  align-items: center;
}

.register-text {
  font-size: 26rpx;
  color: #999;
}

.register-highlight {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: 600;
  margin-left: 6rpx;
}

.register-highlight:active {
  opacity: 0.7;
}

/* ===== 底部装饰 ===== */
.login-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.footer-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #ddd);
}

.footer-line:last-child {
  background: linear-gradient(90deg, #ddd, transparent);
}

.footer-text {
  font-size: 22rpx;
  color: #c0c4cc;
  margin: 0 20rpx;
  letter-spacing: 2rpx;
}
